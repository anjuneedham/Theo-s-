# ---- Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ANCHOR_RESTAURANT_SLUG=theos

# ---- Supabase (leave empty to use the local development data store)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET — server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# ---- Local backend (development / demos)
# DATA_BACKEND=local
# LOCAL_DATA_DIR=.data
# SEED_SAMPLE_ORDERS=true
# Required if the local backend is ever used in production:
SESSION_SECRET=

# ---- Online payments (leave empty: only cash / card on delivery are offered)
PAYMENTS_ONLINE_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Notifications (each channel is skipped and logged until configured)
RESEND_API_KEY=
EMAIL_FROM="Theo's <orders@yourdomain.com>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
